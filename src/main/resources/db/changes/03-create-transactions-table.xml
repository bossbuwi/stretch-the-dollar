<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Changeset 5: Create the transactions table -->
    <changeSet id="5" author="paradoxdevs">
        <createTable tableName="transactions">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- Using VARCHAR for H2 compatibility -->
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- TEXT is fine here since there is no unique constraint/index -->
            <column name="description" type="TEXT">
                <constraints nullable="true"/>
            </column>

            <column name="transaction_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <!-- float4 in Postgres maps to REAL or FLOAT in Liquibase -->
            <column name="amount" type="FLOAT">
                <constraints nullable="false"/>
            </column>

            <column name="currency" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="UUID">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="updated_by" type="UUID">
                <constraints nullable="true"/>
            </column>

            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

        </createTable>
    </changeSet>

    <!-- Changeset 6: Add foreign key for created_by -->
    <changeSet id="6" author="paradoxdevs">
        <addForeignKeyConstraint baseTableName="transactions"
                                 baseColumnNames="created_by"
                                 referencedTableName="users"
                                 referencedColumnNames="uuid"
                                 constraintName="fk_transactions_created_by"
                                 onDelete="SET NULL"/>
    </changeSet>

    <!-- Changeset 7: Add foreign key for updated_by -->
    <changeSet id="7" author="paradoxdevs">
        <addForeignKeyConstraint baseTableName="transactions"
                                 baseColumnNames="updated_by"
                                 referencedTableName="users"
                                 referencedColumnNames="uuid"
                                 constraintName="fk_transactions_updated_by"
                                 onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>