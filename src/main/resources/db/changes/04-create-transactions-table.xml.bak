<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261006-2-create-transactions" author="paradoxdevs">
        <createTable tableName="transactions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_transactions"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(255)"/>

            <!-- FK -> transaction_items.id -->
            <column name="transaction_item_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_transactions_transaction_item"
                             referencedTableName="transaction_items"
                             referencedColumnNames="id"/>
            </column>

            <column name="transaction_type" type="VARCHAR(255)"/>
            <column name="amount" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(255)"/>

            <!-- FK -> users.uuid -->
            <column name="created_by" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_transactions_created_by"
                             referencedTableName="users"
                             referencedColumnNames="uuid"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <!-- FK -> users.uuid -->
            <column name="updated_by" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_transactions_updated_by"
                             referencedTableName="users"
                             referencedColumnNames="uuid"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Index on the FK column to speed up lookups/joins/deletes by transaction item -->
        <createIndex tableName="transactions"
                     indexName="idx_transactions_transaction_item_id">
            <column name="transaction_item_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>