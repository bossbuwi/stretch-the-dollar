<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261006-1-create-transaction-items" author="paradoxdevs">
        <createTable tableName="transaction_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="pk_transaction_items"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_transaction_items_name"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="currency" type="VARCHAR(255)"/>
            <column name="amount_limit" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>

            <!-- FK -> users.uuid -->
            <column name="created_by" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_transaction_items_created_by"
                             referencedTableName="users"
                             referencedColumnNames="uuid"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <!-- FK -> users.uuid -->
            <column name="updated_by" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_transaction_items_updated_by"
                             referencedTableName="users"
                             referencedColumnNames="uuid"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>